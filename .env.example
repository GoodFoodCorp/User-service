PORT=8087
LOG_LEVEL=info
POSTGRES_USER=user_user
POSTGRES_PASSWORD=YOUR_PASSWORD
POSTGRES_DB=user_db
DATABASE_URL=postgres://user_user:YOUR_PASSWORD@localhost:5437/user_db?sslmode=disable
JWT_SECRET=YOUR_SECRET_KEY_HERE
ENV=development
JWT_ISSUER=goodfood-auth
JWT_AUDIENCE=goodfood-api
# Shared secret of the /internal routes (auth-service)
SERVICE_API_KEY=YOUR_SERVICE_KEY
# Avatars in S3-compatible object storage (required when ENV=production).
# Empty S3_BUCKET = local disk under UPLOADS_DIR (development, one replica).
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_SSL=true
S3_PUBLIC_URL=
UPLOADS_DIR=/data/uploads
